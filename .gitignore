# OS
.DS_Store

# Dependencies (root — husky/lint-staged/prettier; server/ e client/ têm o node_modules próprio)
/node_modules/

# IDE
.vscode/
.idea/

# Env files (cada pacote tem o próprio .env.example versionado)
.env
.env.*
!.env.example

# Playwright (E2E, ver /e2e e playwright.config.ts)
/playwright-report/
/test-results/
/blob-report/

# Artefatos compilados dos seeds (o ts-node/Jest resolveria o .js antes do .ts)
server/prisma/*.js
server/prisma/*.js.map
server/prisma/*.d.ts
