// Schema do Prisma — SGM Core
// Ainda sem models: o schema da Ficha (e demais entidades) é código de negócio
// e entra numa etapa seguinte, junto com o CRUD do módulo Fichas.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Paroquia {
  id        String   @id @default(uuid())
  nome      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fichas       Ficha[]
  fichasCasais FichaCasal[]
  montagens    Montagem[]

  montagensSementeira Montagem[] @relation("Sementeira")
}

enum CorCirculo {
  VERMELHO
  AZUL
  VERDE
  AMARELO
  ROSA
  LARANJA
}

enum SituacaoFicha {
  ATIVA
  INATIVA
}

// Ficha do Jovem — ver docs/requisitos.md, seção 2.1.
// Histórico de equipes servidas e Avaliação ficam para o módulo Montagem (dados gerados lá, não aqui).
model Ficha {
  id         String   @id @default(uuid())
  paroquiaId String
  paroquia   Paroquia @relation(fields: [paroquiaId], references: [id])

  // Identificação
  nomeCompleto   String
  dataNascimento DateTime
  naturalidade   String?
  telefone       String
  email          String?
  fotoUrl        String?

  // Endereço
  logradouro  String?
  numero      String?
  complemento String?
  bairro      String?
  cidade      String?
  estado      String?
  cep         String?

  // Filiação
  nomePai String?
  nomeMae String?

  // Escolaridade
  grauEscolaridade String?
  curso            String?
  instituicao      String?
  situacaoEscolar  String?

  // Religião
  religiao                String?
  igrejaQueFrequenta      String?
  participaOutroMovimento Boolean @default(false)
  qualMovimento           String?
  sacramentoBatismo       Boolean @default(false)
  sacramentoEucaristia    Boolean @default(false)
  sacramentoCrisma        Boolean @default(false)

  // Convite
  nomeConvidante     String?
  telefoneConvidante String?
  enderecoConvidante String?

  observacoes String?

  numeroEncontro Int
  corCirculo     CorCirculo

  situacao          SituacaoFicha @default(ATIVA)
  motivoDesativacao String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  alocacoes Alocacao[]

  @@index([paroquiaId])
}

// Ficha do Casal — ver docs/requisitos.md, seção 2.1. Casais vêm do ECC (Encontro de Casais
// com Cristo) e servem as equipes do encontro; não "vivenciam" um encontro do Segue-me, por
// isso não têm numeroEncontro/corCirculo. Histórico de equipes servidas e Avaliação ficam
// para o módulo Montagem, igual à Ficha do Jovem.
model FichaCasal {
  id         String   @id @default(uuid())
  paroquiaId String
  paroquia   Paroquia @relation(fields: [paroquiaId], references: [id])

  // Identificação
  nomeEle           String
  nomeEla           String
  dataNascimentoEle DateTime?
  dataNascimentoEla DateTime?
  telefoneEle       String
  telefoneEla       String
  emailEle          String?
  emailEla          String?
  fotoUrl           String?

  // Endereço
  logradouro  String?
  numero      String?
  complemento String?
  bairro      String?
  cidade      String?
  estado      String?
  cep         String?

  temFilhosNoSegueMe Boolean @default(false)
  observacoesFilhos  String?
  observacoes        String?

  situacao          SituacaoFicha @default(ATIVA)
  motivoDesativacao String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  alocacoes Alocacao[]

  @@index([paroquiaId])
}

// ---------------------------------------------------------------------------
// Módulo Montagem — ver docs/requisitos.md (seção 2.2), docs/regras-imutaveis.md
// (R1-R9) e docs/ux-e-fluxos.md (seção 3). Esta etapa modela o schema e o CRUD
// básico; as regras R1-R9 (bloqueios, avisos, sugestão de coordenadores) ainda
// não estão implementadas na Service — ver plano da etapa.
// ---------------------------------------------------------------------------

// Catálogo das 16 equipes do encontro (Comando Geral + 15). Estrutura idêntica
// entre paróquias (R7/R9), por isso não tem paroquiaId — é dado global, seedado.
model Equipe {
  id         String  @id @default(uuid())
  nome       String  @unique
  slug       String  @unique
  ordem      Int
  ehCirculos Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cargos Cargo[]
  vagas  VagaMontagem[]
}

// Cargo dentro de uma equipe (ex.: Coordenação, Apoio, Componentes, Pilotos...).
// quantidadeDinamica marca cargos cuja quantidade não é fixa no catálogo e
// precisa ser calculada na criação da Montagem (hoje só o "Componentes" da
// Eq. da Visitação, ver R6 — ~1 casal para cada 3 jovens vivenciando).
model Cargo {
  id       String @id @default(uuid())
  equipeId String
  equipe   Equipe @relation(fields: [equipeId], references: [id])

  nome  String
  ordem Int

  quantidadeCasais  Int @default(0)
  quantidadeRapazes Int @default(0)
  quantidadeMocas   Int @default(0)

  quantidadeDinamica Boolean @default(false)
  ehCoordenacao      Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vagas VagaMontagem[]

  @@unique([equipeId, nome])
}

enum StatusMontagem {
  EM_ANDAMENTO
  FINALIZADA
}

// Um encontro de uma paróquia. numeroEncontro é auto-incrementado por paróquia
// (calculado na Service, não no banco).
model Montagem {
  id         String   @id @default(uuid())
  paroquiaId String
  paroquia   Paroquia @relation(fields: [paroquiaId], references: [id])

  numeroEncontro    Int
  data              DateTime
  padroeiro         String?
  diretorEspiritual String?

  ehSementeira               Boolean   @default(false)
  paroquiaSementeiraId       String?
  paroquiaSementeira         Paroquia? @relation("Sementeira", fields: [paroquiaSementeiraId], references: [id])
  quantidadeFichasSementeira Int?

  numeroJovensVivenciando Int

  status StatusMontagem @default(EM_ANDAMENTO)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vagas VagaMontagem[]

  @@unique([paroquiaId, numeroEncontro])
  @@index([paroquiaId])
}

// Instância de um Cargo dentro de uma Montagem específica — quantidades
// concretas (cópia do Cargo pra maioria das equipes; calculada dinamicamente
// pra Eq. da Visitação no momento da criação da Montagem).
model VagaMontagem {
  id String @id @default(uuid())

  montagemId String
  montagem   Montagem @relation(fields: [montagemId], references: [id])

  equipeId String
  equipe   Equipe @relation(fields: [equipeId], references: [id])

  cargoId String
  cargo   Cargo  @relation(fields: [cargoId], references: [id])

  quantidadeCasais  Int
  quantidadeRapazes Int
  quantidadeMocas   Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  alocacoes Alocacao[]

  @@index([montagemId])
  @@index([equipeId])
}

enum TipoPessoa {
  JOVEM
  CASAL
}

enum StatusConvite {
  RASCUNHO
  CONVIDADO
  ACEITO
  RECUSADO
  DESISTIU
  SUBSTITUIDO
}

// Pessoa (Ficha ou FichaCasal) atribuída a uma VagaMontagem. A atribuição em
// si (criar a Alocacao) é sempre livre — o bloqueio do R4 (Círculos primeiro)
// e as regras R1-R3, quando implementadas, vão validar a transição de
// `status`, não a criação da Alocacao (ver nota de "montagem volátil" no
// plano desta etapa).
model Alocacao {
  id String @id @default(uuid())

  vagaMontagemId String
  vagaMontagem   VagaMontagem @relation(fields: [vagaMontagemId], references: [id])

  tipoPessoa TipoPessoa

  fichaId String?
  ficha   Ficha?  @relation(fields: [fichaId], references: [id])

  fichaCasalId String?
  fichaCasal   FichaCasal? @relation(fields: [fichaCasalId], references: [id])

  status       StatusConvite @default(RASCUNHO)
  dataConvite  DateTime?
  dataResposta DateTime?
  motivoRecusa String?

  // Avaliação (alimenta o Histórico da Ficha — ver docs/requisitos.md, seção 2.1)
  podeCoordenar         Boolean?
  podePalestrar         Boolean?
  observacoesAvaliacao  String?

  substituidaPorId String?   @unique
  substituidaPor   Alocacao? @relation("Substituicao", fields: [substituidaPorId], references: [id])
  substitutaDe     Alocacao? @relation("Substituicao")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vagaMontagemId])
  @@index([fichaId])
  @@index([fichaCasalId])
}
