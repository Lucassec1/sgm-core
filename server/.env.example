# Copie para .env e ajuste conforme o ambiente
DATABASE_URL="postgresql://sgm:sgm@localhost:5432/sgm_core?schema=public"
JWT_SECRET="troque-por-um-segredo-forte"
JWT_EXPIRES_IN="12h"
PORT=3001
# Origens permitidas no CORS, separadas por vírgula (ex.: https://sgm.exemplo.org).
# Sem esta variável o servidor reflete qualquer origem — ok só pra dev local.
CORS_ORIGINS=""
# Nível do logger estruturado (pino) — trace|debug|info|warn|error|fatal.
LOG_LEVEL="info"
# Opcional — rastreamento de erro (Sentry). Sem esta variável, o Sentry fica inativo (ver
# src/instrument.ts).
# SENTRY_DSN=""
# Upload de fotos (Ficha/FichaCasal) e Quadrantes (PDF) — S3, não filesystem (hospedagem com
# disco efêmero perderia o arquivo a cada restart/deploy). Ver common/uploads/s3-storage.ts.
AWS_REGION="us-east-1"
S3_BUCKET_NAME="sgm-core-uploads"
AWS_ACCESS_KEY_ID="troque-pela-access-key-do-usuario-IAM"
AWS_SECRET_ACCESS_KEY="troque-pela-secret-key-do-usuario-IAM"
# Link de criar senha (primeiro acesso) / redefinir (esqueceu) via Amazon SES (mesmas credenciais
# AWS acima + ses:SendEmail). Sem EMAIL_REMETENTE, em dev o link aparece no log do server; em
# produção o e-mail não é enviado — e paróquia nova não consegue fazer o primeiro acesso.
# EMAIL_REMETENTE="SGM Core <nao-responda@seudominio.org>"
# SES_REGION="us-east-1"  # opcional, padrão = AWS_REGION
# CLIENT_URL="http://localhost:3000"  # opcional, padrão = primeira origem do CORS_ORIGINS
